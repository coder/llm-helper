  "source": {
    "repo": "MiaAI-Lab/GLM-5.3-Flash-EXL3-2x-DGX-Sparks-TensorFold",
    "path": "scripts/config.sh",
    "commit": "bf5f94523a8251029cedae86bf61f8ce37fac218",
    "license": "Apache-2.0",
    "format": "env-sh",
    "deviations": [
      {
        "kind": "config",
        "setting": "SPILL_GIB",
        "upstream": "0",
        "ours": "128",
        "why": "The spill tier keeps prompt states on disk, so long agent conversations come back after a restart without a new prefill. 128 GiB a Spark is what the deployment ran with."
      },
      {
        "kind": "env",
        "setting": "TF_GLM_EFFORT_TAIL",
        "upstream": "0",
        "ours": "1",
        "why": "Renders the reasoning-effort line at the prompt's tail, so switching effort or thinking keeps the kept-prompt cache warm (issue #93). The serving deployment ran with it on; upstream leaves it off until the effort levels are checked."
      },
      {
        "kind": "env",
        "setting": "TF_GLM_KEEP_PER_CHAT",
        "upstream": "0",
        "ours": "2",
        "why": "At most 2 kept states for one conversation, the author's value, so one long chat cannot fill the cache's entries alone. The serving deployment ran with it."
      },
      {
        "kind": "config",
        "setting": "HOST",
        "upstream": "0.0.0.0",
        "ours": "127.0.0.1",
        "why": "TensorFold checks no API key, so rank 0 listens on loopback and a proxy that checks one serves the network."
      },
      {
        "kind": "config",
        "setting": "PORT",
        "upstream": "8888",
        "ours": "8889",
        "why": "The proxy in front holds 8888."
      }
    ]
  },
